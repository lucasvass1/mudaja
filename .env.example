# Configure estas variáveis em Vercel > Project Settings > Environment Variables.
# Este arquivo é só referência — não coloque valores reais aqui.

# Resend (https://resend.com) — usado por api/notify-lead.js e api/send-launch-campaign.js
RESEND_API_KEY=
RESEND_FROM_EMAIL=MudaJá <avisos@seudominio.com>

# api/notify-lead.js — para onde vai o aviso de "novo lead" a cada cadastro
TEAM_NOTIFY_EMAIL=equipe@seudominio.com

# api/send-launch-campaign.js — busca leads direto no Supabase (bypassa RLS)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# api/send-launch-campaign.js — token que protege o disparo manual da campanha
# (gere algo aleatório, ex: openssl rand -hex 32)
CAMPAIGN_SECRET=
